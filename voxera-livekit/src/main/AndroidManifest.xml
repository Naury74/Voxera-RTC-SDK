<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        화면 공유는 LiveKit AAR이 선언하는 ScreenCaptureService(mediaProjection foreground service)를 쓴다.
        화면 공유를 쓰지 않는 호스트는 docs/permissions.md에 적은 대로 앱 manifest에서 그 서비스와 권한을 제거할 수 있다.
    -->

    <!-- Android 12+에서 블루투스 이어폰을 오디오 경로로 찾고 고르려면 필요하다. 런타임 요청은 호스트가 한다. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

</manifest>
